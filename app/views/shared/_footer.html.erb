<footer class="sidebar__footer">
  <% if auth_required? && logged_in? %>
    <div class="sidebar__user-section">
      <div class="sidebar__user-badge">
        <span class="sidebar__user-avatar">👤</span>
        <span class="sidebar__user-name" title="<%= current_user_name %>"><%= current_user_name %></span>
      </div>
      <%= button_to logout_path, method: :delete, class: 'sidebar__logout-btn', title: 'Sign out', data: { turbo: false } do %>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
      <% end %>
    </div>
  <% end %>
  <span class="text-muted text-xs">Lumen Space v<%= app_version %> &bull; <%= app_build_date %></span>
</footer>
